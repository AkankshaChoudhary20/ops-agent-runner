# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used to drive the agent loop. Defaults to claude-sonnet-5 in code if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://postgres:postgres@localhost:5435/agentic_ops_builder

# Port the Express server listens on
PORT=3000

# Max tool-use steps per run before the agent loop is forcibly stopped
MAX_AGENT_STEPS=8
